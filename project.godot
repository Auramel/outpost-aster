config_version=5

[application]
config/name="Форпост Астер"
config/version="0.0.1"
config/icon="res://assets/aster.png"
run/main_scene="res://scenes/loading.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.067, 0.102, 1)
boot_splash/image="res://assets/aster.png"
boot_splash/stretch_mode=0

[display]
window/size/mode=3
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_device/driver.macos="metal"
environment/ssao/quality=1
anti_aliasing/quality/msaa_3d=1
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.34, 0.42, 0.49, 1)
lights_and_shadows/directional_shadow/size=2048

[physics]
common/physics_ticks_per_second=60
